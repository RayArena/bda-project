# ========================================================
# Real-Time Twitter Sentiment Analysis Environment Config
# Copy this file to .env and adjust your configuration values.
# ========================================================

# --------------------------------------------------------
# MongoDB Settings
# --------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

MONGO_DB_NAME=bigdata_project
MONGO_COLLECTION=tweets

# --------------------------------------------------------
# Apache Kafka Settings
# --------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=numtest
KAFKA_CONSUMER_GROUP=my-group

# --------------------------------------------------------
# System Paths  (macOS / Linux)  — edit these for your machine.
# Change a path here once and every shell script + Python file uses it.
# --------------------------------------------------------
# Java (JDK) install. macOS + Homebrew (Apple Silicon): /opt/homebrew/opt/openjdk
# Intel macOS: /usr/local/opt/openjdk   ·   Linux: e.g. /usr/lib/jvm/java-23
JAVA_HOME=/opt/homebrew/opt/openjdk

# Apache Kafka folder that contains bin/ and config/ (the extracted tarball).
# CHANGE THIS to where you unpacked Kafka, e.g. /Users/you/kafka_2.13-3.9.2
KAFKA_HOME=/Users/you/kafka_2.13-3.9.2

# JVM heap for the Kafka broker (quote it — it contains a space).
KAFKA_HEAP_OPTS="-Xmx1G -Xms1G"

# HADOOP_HOME is only needed on Windows (winutils). Leave blank on macOS/Linux.
HADOOP_HOME=

# Python interpreter. Blank = auto-detect project .venv, then python3.
PYTHON_EXE=

# --------------------------------------------------------
# Project Data / Model Paths
# Absolute paths recommended so every script resolves them identically.
# Leave blank to fall back to the in-repo defaults.
# --------------------------------------------------------
# Trained PySpark model (used by BOTH the consumer and the Django classifier).
MODEL_PATH=
# Validation tweets CSV streamed by the producer.
VALIDATION_CSV=

# --------------------------------------------------------
# Django Dashboard Settings
# --------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-qkl0cdk^3k(_)oc(gx#obz(g8)t#40t)6)8%c!%2c(0nl4b)&#
DJANGO_DEBUG=True
DJANGO_HOST=127.0.0.1
DJANGO_PORT=8000
