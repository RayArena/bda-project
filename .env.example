# ========================================================
# Real-Time Twitter Sentiment Analysis Environment Config
# Copy this file to .env and adjust your configuration values.
# ========================================================

# --------------------------------------------------------
# MongoDB Settings
# --------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

MONGO_DB_NAME=bigdata_project
MONGO_COLLECTION=tweets

# --------------------------------------------------------
# Apache Kafka Settings
# --------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=numtest
KAFKA_CONSUMER_GROUP=my-group

# --------------------------------------------------------
# Django Dashboard Settings
# --------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-qkl0cdk^3k(_)oc(gx#obz(g8)t#40t)6)8%c!%2c(0nl4b)&#
DJANGO_DEBUG=True
DJANGO_HOST=127.0.0.1
DJANGO_PORT=8000
